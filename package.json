{
  "name": "dsh-live2d-pet-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Live2D 桌宠插件 for DeepSeek Harness — 角色资产流水线 + 可发布的插件包",
  "license": "MIT",
  "packageManager": "pnpm@10.30.2",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter dsh-live2d-pet build && pnpm --filter dsh-pet-shell build",
    "test": "pnpm test:bridge && pnpm test:harness && pnpm test:shell && pnpm test:model && pnpm test:failover",
    "test:bridge": "node packages/dsh-live2d-pet/test/bridge.test.mjs",
    "test:shell": "node packages/dsh-pet-shell/test/smoke.mjs",
    "test:model": "node live2d-pipeline/tools/verify.mjs",
    "sync": "./scripts/sync.sh",
    "assets:live2d": "node scripts/fetch-live2d-assets.mjs",
    "assets:live2d:list": "node scripts/fetch-live2d-assets.mjs --list",
    "characters": "node scripts/character.mjs list",
    "characters:build": "node scripts/character.mjs build",
    "characters:rerig": "node scripts/character.mjs build --rerig",
    "assets:whale-maid": "node scripts/fetch-whale-maid-art.mjs",
    "test:harness": "node packages/dsh-live2d-pet/test/harness.test.mjs",
    "test:failover": "node packages/dsh-route-failover/test/failover.test.mjs",
    "assets:gugu": "node scripts/fetch-gugu-assets.mjs"
  },
  "devDependencies": {
    "ag-psd": "^31.0.2",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "undici": "^8.10.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
